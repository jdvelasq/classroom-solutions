import pytest
import xml.dom.minidom
import os

pytest.main(["--junitxml", "grader.xml"])
doc = xml.dom.minidom.parse("grader.xml")
os.remove("grader.xml")

items = doc.getElementsByTagName("testsuite")
failures = items[0].attributes["failures"].value
errors = items[0].attributes["errors"].value
skipped = items[0].attributes["skipped"].value
tests = items[0].attributes["tests"].value
